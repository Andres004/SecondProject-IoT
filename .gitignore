# Build files and editor data that PlatformIO creates on each computer
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Serial monitor sessions saved by log2file
platformio-device-monitor-*.log

# WiFi password and server address of each computer
include/Secrets.h

# Python cache and virtual environment
__pycache__/
*.pyc
.venv/

# CSV files that the server writes while it runs
server/logs/

# Folders of AI tools and files of the operating system
.agent/
.claude/
.cursor/
.DS_Store
Thumbs.db

logs/
